MONGODB_URI=your_mongodb_connection_string
# OpenAI API key for the separate Data Detective feature only
OPENAI_API_KEY=your_openai_api_key
DATA_DETECTIVE_MODEL=gpt-6-astra
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_ASR_MODEL=frozenlab/qwen3-asr:1.7b
OLLAMA_KEEP_ALIVE=30m
# Local English speech service used as a full-recording fallback when browser dictation is unavailable.
SPEECH_SERVICE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SPEECH_URL=http://127.0.0.1:8000
WHISPER_PROFILE=fast
