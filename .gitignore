# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/.venv/
/.cache/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-deploy-check/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# exports
/exports

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python bytecode
__pycache__/
*.py[cod]

# Local speech model downloads (must be fetched by the speech service)
/models/blobs/
/models/CACHEDIR.TAG
/models/models--*/
/services/models/

# Local patch/debug snapshots
/diff.txt
/last_commit_diff.txt
/patch*.py
